<mxfile host="app.diagrams.net">
  <diagram name="ETL Pipeline - Lab2" id="lab2-pipeline">
    <mxGraphModel dx="896" dy="525" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#111827;align=left;verticalAlign=middle;" value="ETL Pipeline - Retail Dimensional Data Warehouse (LAB-2)" vertex="1">
          <mxGeometry height="30" width="900" x="20" y="20" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;fontSize=12;fontStyle=2;fontColor=#4b5563;align=left;verticalAlign=middle;" value="Business Requirements -&gt; Source Data -&gt; ETL -&gt; Dimensional Model -&gt; SQL/KPIs -&gt; Business Decisions" vertex="1">
          <mxGeometry height="22" width="900" x="20" y="52" as="geometry" />
        </mxCell>
        <mxCell id="src1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f2a44;strokeColor=#6b7aa1;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;spacing=6;" value="sales_transactions.csv (sales line items / POS grain)" vertex="1">
          <mxGeometry height="60" width="230" x="40" y="120" as="geometry" />
        </mxCell>
        <mxCell id="src2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f2a44;strokeColor=#6b7aa1;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;spacing=6;" value="reference_data.json products collection" vertex="1">
          <mxGeometry height="60" width="230" x="40" y="200" as="geometry" />
        </mxCell>
        <mxCell id="src3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f2a44;strokeColor=#6b7aa1;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;spacing=6;" value="reference_data.json stores collection" vertex="1">
          <mxGeometry height="60" width="230" x="40" y="280" as="geometry" />
        </mxCell>
        <mxCell id="src4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f2a44;strokeColor=#6b7aa1;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;spacing=6;" value="reference_data.json channels collection" vertex="1">
          <mxGeometry height="60" width="230" x="40" y="360" as="geometry" />
        </mxCell>
        <mxCell id="src5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f2a44;strokeColor=#6b7aa1;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;spacing=6;" value="reference_data.json promotions collection" vertex="1">
          <mxGeometry height="60" width="230" x="40" y="440" as="geometry" />
        </mxCell>
        <mxCell id="stage1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7a4a1e;strokeColor=#c98a4b;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacing=6;" value="EXTRACT  extract.py connects to each source and reads raw rows from sales_transactions.csv and reference_data.json." vertex="1">
          <mxGeometry height="150" width="250" x="560" y="235" as="geometry" />
        </mxCell>
        <mxCell id="stage2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5b3a63;strokeColor=#9a7ab8;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacing=6;" value="TRANSFORM / CLEAN  transform.py trims strings, parses/validates sale_date, casts numeric types, drops duplicate sale_line_id and non-positive qty/price rows, fills missing promotion_id, and rejects rows that fail referential integrity against reference_data.json." vertex="1">
          <mxGeometry height="150" width="250" x="940" y="235" as="geometry" />
        </mxCell>
        <mxCell id="stage3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6b5b13;strokeColor=#c9b23f;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacing=6;" value="CREATE SCHEMA  create_schema.py (re)builds the Star Schema in SQLite: 5 dimension tables with surrogate integer PKs, FactSales with 5 FKs and PRAGMA foreign_keys=ON, plus indexes on every FK." vertex="1">
          <mxGeometry height="150" width="250" x="1420" y="235" as="geometry" />
        </mxCell>
        <mxCell id="stage4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2f5233;strokeColor=#7fae86;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacing=6;" value="LOAD DIMENSIONS  load_dimensions.py loads DimDate, DimProduct, DimStore, DimChannel, DimPromotion FIRST, generating surrogate keys and returning natural-key -&gt; surrogate-key lookup dictionaries." vertex="1">
          <mxGeometry height="150" width="250" x="1820" y="235" as="geometry" />
        </mxCell>
        <mxCell id="stage5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f6f5c;strokeColor=#5fb8a2;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacing=6;" value="LOAD FACT  load_fact.py computes Quantity, Gross Sales, Net Sales, Discount Amount, Cost Amount and Gross Profit, maps every FK via the lookups, and loads FactSales only after step 4 completes." vertex="1">
          <mxGeometry height="150" width="250" x="2200" y="235" as="geometry" />
        </mxCell>
        <mxCell id="stage6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f3a5c;strokeColor=#5f8fc9;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacing=6;" value="VALIDATE / QUERY  queries.py runs one SQL query per business requirement, directly against the warehouse tables, proving the Star Schema actually answers each analytical question." vertex="1">
          <mxGeometry height="150" width="250" x="2580" y="235" as="geometry" />
        </mxCell>
        <mxCell id="stage7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4a4a4a;strokeColor=#9a9a9a;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacing=6;" value="VISUALIZE  generate_visualizations.py, builds the first requirement monthly net sales trend line chart and the third requirement net-sales-by-category bar chart, reading only from retail_dw.db." vertex="1">
          <mxGeometry height="150" width="250" x="2970" y="235" as="geometry" />
        </mxCell>
        <mxCell id="stage8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0e7c7b;strokeColor=#4fc3bf;fontColor=#ffffff;fontSize=10;align=center;verticalAlign=middle;spacing=6;" value="BUSINESS DECISIONS  Management reviews monthly trend, store/channel comparison, top categories/brands, promotion effectiveness, and gross margin by category/store/month to guide retail decisions." vertex="1">
          <mxGeometry height="150" width="250" x="3370" y="235" as="geometry" />
        </mxCell>
        <mxCell id="fail_stage1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5c2626;strokeColor=#b06a6a;fontColor=#ffffff;fontStyle=2;fontSize=9;align=center;verticalAlign=middle;dashed=1;spacing=4;" value="Possible failure: missing/renamed source file crashes extract_sales() or extract_reference(); no upfront schema check on the raw file." vertex="1">
          <mxGeometry height="110" width="250" x="560" y="425" as="geometry" />
        </mxCell>
        <mxCell id="fail_stage2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5c2626;strokeColor=#b06a6a;fontColor=#ffffff;fontStyle=2;fontSize=9;align=center;verticalAlign=middle;dashed=1;spacing=4;" value="Possible failure: an overly strict referential-integrity check silently drops valid rows if reference_data.json&#39;s structure changes; dropped rows are only visible in the printed data quality report." vertex="1">
          <mxGeometry height="110" width="250" x="940" y="425" as="geometry" />
        </mxCell>
        <mxCell id="fail_stage3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5c2626;strokeColor=#b06a6a;fontColor=#ffffff;fontStyle=2;fontSize=9;align=center;verticalAlign=middle;dashed=1;spacing=4;" value="Possible failure: DROP TABLE IF EXISTS wipes prior data on every re-run with no backup or versioning of retail_dw.db." vertex="1">
          <mxGeometry height="110" width="250" x="1420" y="425" as="geometry" />
        </mxCell>
        <mxCell id="fail_stage4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5c2626;strokeColor=#b06a6a;fontColor=#ffffff;fontStyle=2;fontSize=9;align=center;verticalAlign=middle;dashed=1;spacing=4;" value="Possible failure: duplicate natural keys inside reference_data.json would silently overwrite prior lookup entries, causing rows to be mapped to the wrong surrogate key." vertex="1">
          <mxGeometry height="110" width="250" x="1820" y="425" as="geometry" />
        </mxCell>
        <mxCell id="fail_stage5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5c2626;strokeColor=#b06a6a;fontColor=#ffffff;fontStyle=2;fontSize=9;align=center;verticalAlign=middle;dashed=1;spacing=4;" value="Possible failure: a product_id missing from products_by_id raises KeyError mid-loop, leaving FactSales partially loaded." vertex="1">
          <mxGeometry height="110" width="250" x="2200" y="425" as="geometry" />
        </mxCell>
        <mxCell id="fail_stage6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5c2626;strokeColor=#b06a6a;fontColor=#ffffff;fontStyle=2;fontSize=9;align=center;verticalAlign=middle;dashed=1;spacing=4;" value="Possible failure: a wrong GROUP BY grain in a query double-counts net_sales across joined dimensions (e.g. joining DimDate at day grain while grouping only by month)." vertex="1">
          <mxGeometry height="110" width="250" x="2580" y="425" as="geometry" />
        </mxCell>
        <mxCell id="fail_stage7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5c2626;strokeColor=#b06a6a;fontColor=#ffffff;fontStyle=2;fontSize=9;align=center;verticalAlign=middle;dashed=1;spacing=4;" value="Possible failure: charts are generated against a stale retail_dw.db if main.py was not re-run after the source data changed." vertex="1">
          <mxGeometry height="110" width="250" x="2970" y="425" as="geometry" />
        </mxCell>
        <mxCell id="fail_stage8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5c2626;strokeColor=#b06a6a;fontColor=#ffffff;fontStyle=2;fontSize=9;align=center;verticalAlign=middle;dashed=1;spacing=4;" value="Possible failure: stakeholders misread COP magnitude (&quot;M&quot; scale) or miss that gross_margin_% is query-time only, never stored in the fact." vertex="1">
          <mxGeometry height="110" width="250" x="3370" y="425" as="geometry" />
        </mxCell>
        <mxCell id="e_src1" edge="1" parent="1" source="src1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6b7aa1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="stage1" value="">
